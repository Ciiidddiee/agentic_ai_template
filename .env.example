# Internal LLM gateway (OpenAI-compatible). base_url must include the version prefix, e.g. /v1
LLM_BASE_URL=https://llm-gateway.internal.example.com/v1
LLM_MODEL=your-chat-model
LLM_TOKEN=
EMBED_MODEL=your-embedding-model

# Config file used by the CLI and API (relative to the repo root)
AIKIT_CONFIG=project/app.yaml

# Set to 1 to swap every LLM and embedder for offline fakes
AIKIT_OFFLINE=0
